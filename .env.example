# Public site URL, used for canonical links, Open Graph URLs and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Set to "false" to hide the draft notices and [CONFIRM ...] notes once the content is final.
NEXT_PUBLIC_SHOW_DRAFT_NOTICES=true

# Where each form's submissions are forwarded (JSON POST). Leave empty to run the form in preview
# mode: the server validates the submission, logs it and returns success without storing or sending it.
WAITLIST_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
CAREERS_WEBHOOK_URL=
